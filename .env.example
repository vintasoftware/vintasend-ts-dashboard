# Auth provider selection: clerk or auth0
AUTH_PROVIDER=clerk

# Clerk configuration (required when AUTH_PROVIDER=clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Auth0 v4 configuration (required when AUTH_PROVIDER=auth0)
# Note: Auth0 v4 uses different environment variables than v3
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# VintaSend API (https://github.com/vintasoftware/vintasend-ts-api).
# The dashboard reads all notification data through this API; it never talks to
# a notification backend directly. The key is server-side only.
VINTASEND_API_URL=http://localhost:3333
VINTASEND_API_KEY=
